{
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'; connect-src https://auth.openai.com https://api.openai.com http://127.0.0.1:* http://localhost:* https://127.0.0.1:* https://localhost:*"
  },
  "name": "Translate with AI",
  "default_locale": "en",
  "options_page": "index.html",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "storage",
    "offscreen",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Translate with AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "manifest_version": 3,
  "host_permissions": [
    "https://auth.openai.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "callback.html"
      ]
    }
  ],
  "description": "__MSG_extensionDescription__"
}
